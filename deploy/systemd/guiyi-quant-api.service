[Unit]
Description=Guiyi Quant FastAPI
After=network-online.target docker.service
Wants=network-online.target

[Service]
Type=simple
User=ubuntu
Group=ubuntu
WorkingDirectory=/path/to/guiyi-quant-workstation/services/quant-api
EnvironmentFile=/etc/guiyi-quant/guiyi-quant.env
ExecStart=/home/ubuntu/.local/bin/uv run uvicorn app.main:app --host 127.0.0.1 --port 8000 --workers 2 --no-access-log
Restart=on-failure
RestartSec=5
TimeoutStopSec=30
KillSignal=SIGTERM
NoNewPrivileges=true
PrivateTmp=true
StandardOutput=journal
StandardError=journal
SyslogIdentifier=guiyi-quant-api

[Install]
WantedBy=guiyi-quant.target
