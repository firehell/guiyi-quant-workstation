# ============================================================
# 归一量化工作站 — 环境变量模板
# 复制为 .env 并填入真实值，.env 文件严禁提交到 Git
# ============================================================

# ── 应用基础配置 ────────────────────────────────────────────
APP_ENV=development          # development | staging | production
APP_PORT=8000
APP_SECRET_KEY=change-me-to-a-random-secret

# ── 数据库 ──────────────────────────────────────────────────
DATABASE_URL=postgresql://user:password@localhost:5432/guiyi_quant
REDIS_URL=redis://localhost:6379/0

# ── 期货行情数据源 ────────────────────────────────────────────
# CTP / 期货公司接口
CTP_BROKER_ID=
CTP_USER_ID=
CTP_PASSWORD=
CTP_FRONT_ADDRESS=tcp://180.168.146.187:10101

# Tushare（行情数据备用）
TUSHARE_TOKEN=

# AKShare（免费行情数据）
# 无需 Token，直接使用

# ── 前端配置 ─────────────────────────────────────────────────
VITE_API_BASE_URL=http://localhost:8000/api/v1
VITE_WS_URL=ws://localhost:8000/ws

# ── 回测引擎 ─────────────────────────────────────────────────
BACKTEST_DATA_PATH=./data/parquet
BACKTEST_RESULT_PATH=./backtests/results
BACKTEST_MAX_WORKERS=4

# ── 风控参数 ─────────────────────────────────────────────────
RISK_MAX_POSITION_RATIO=0.2    # 单品种最大仓位比例
RISK_MAX_DAILY_LOSS=0.05       # 单日最大亏损比例
RISK_MAX_DRAWDOWN=0.15         # 最大回撤阈值

# ── 日志 ─────────────────────────────────────────────────────
LOG_LEVEL=INFO                 # DEBUG | INFO | WARNING | ERROR
LOG_FILE=./logs/app.log

# ── Docker ───────────────────────────────────────────────────
POSTGRES_USER=guiyi
POSTGRES_PASSWORD=change-me
POSTGRES_DB=guiyi_quant
