<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
  <key>Label</key><string>com.guiyi.quant-log-rotate</string>
  <key>ProgramArguments</key><array><string>/bin/bash</string><string>__RUNTIME_DIR__/rotate-local-service-logs.sh</string></array>
  <key>WorkingDirectory</key><string>__HOME__</string>
  <key>StartCalendarInterval</key><dict><key>Hour</key><integer>3</integer><key>Minute</key><integer>15</integer></dict>
  <key>EnvironmentVariables</key><dict><key>PATH</key><string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string></dict>
  <key>StandardOutPath</key><string>__LOG_DIR__/log-rotate.log</string>
  <key>StandardErrorPath</key><string>__LOG_DIR__/log-rotate.log</string>
</dict></plist>
