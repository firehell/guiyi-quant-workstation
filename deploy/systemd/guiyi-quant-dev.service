[Unit]
Description=Guiyi Quant dev stack (API + Web + workers)
After=network-online.target docker.service
Wants=network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=/path/to/guiyi-quant-workstation
ExecStart=/path/to/guiyi-quant-workstation/scripts/dev-up.sh
ExecStop=/path/to/guiyi-quant-workstation/scripts/dev-down.sh --keep-docker
User=ubuntu
Group=ubuntu
Environment=HOME=/home/ubuntu

[Install]
WantedBy=multi-user.target

# 安装说明（需人工修改 WorkingDirectory / User / 绝对路径后执行）：
#   sudo cp deploy/systemd/guiyi-quant-dev.service /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now guiyi-quant-dev.service
#
# 注意：dev-up.sh 健康检查失败会 exit 1，便于 systemd 感知启动异常。
