# ============================================================
# 归一量化工作站 — 环境变量模板
# 复制为 .env 并填入真实值，.env 文件严禁提交到 Git
# ============================================================

# ── 应用基础配置 ────────────────────────────────────────────
APP_ENV=development          # development | staging | production
APP_PORT=8000
APP_SECRET_KEY=change-me-to-a-random-secret

# ── 数据库 ──────────────────────────────────────────────────
# 必须使用 postgresql+psycopg（psycopg v3）；裸 postgresql:// 会误选 psycopg2
DATABASE_URL=postgresql+psycopg://guiyi:guiyi_dev_password@127.0.0.1:5432/guiyi_quant
REDIS_URL=redis://127.0.0.1:6379/0

# ── 期货行情数据源 ────────────────────────────────────────────
# V1 主链路：RQData → standard parquet → DuckDB/PostgreSQL → vn.py 回测。
# Local Parquet 是 V1 本地正式数据湖；TqSdk / TuShare / CTP 默认禁用。
GUIYI_DATA_SOURCE_PRIMARY=rqdata
GUIYI_DATA_SOURCE_FALLBACKS=local_parquet

# 米筐 / RQData（真实 license 只写入本地 .env，严禁提交）
# 方式一（推荐）：license key，脚本会调用 rqdatac.init("license", ...)
RQDATA_LICENSE_KEY=
# 方式二：完整 URI（与 rqsdk 配置一致时可二选一）
# RQDATAC2_CONF=rqdata://license:YOUR_LICENSE_KEY@rqdatad-pro.ricequant.com:16011
# 方式三：账号密码（较少用）
# RQDATA_USERNAME=
# RQDATA_PASSWORD=
# RQDATA_ADDR=rqdatad-pro.ricequant.com:16011

# 天勤专业版 / TqSdk（V2 candidate / validation source，默认禁用）
# V1 不使用 TqSdk 作为主数据源，不调用 TqSdk 交易接口。
# TQSDK_USERNAME=
# TQSDK_PASSWORD=

# CTP / 期货公司接口（V2 后期候选，默认禁用）
# V1 不连接 CTP，不做实盘，不自动下单。
# CTP_BROKER_ID=
# CTP_USER_ID=
# CTP_PASSWORD=
# CTP_FRONT_ADDRESS=

# TuShare（later auxiliary，非 V1 主链路，默认禁用）
# TUSHARE_TOKEN=

# AKShare（后期辅助候选，非 V1 主链路）
# 无需 Token；V1 默认不使用。

# ── 前端配置 ─────────────────────────────────────────────────
VITE_API_BASE_URL=http://localhost:8000/api/v1
VITE_WS_URL=ws://localhost:8000/ws

# ── 回测引擎 ─────────────────────────────────────────────────
BACKTEST_DATA_PATH=./data/parquet
BACKTEST_RESULT_PATH=./backtests/results
BACKTEST_MAX_WORKERS=4

# ── 风控参数 ─────────────────────────────────────────────────
RISK_MAX_POSITION_RATIO=0.2    # 单品种最大仓位比例
RISK_MAX_DAILY_LOSS=0.05       # 单日最大亏损比例
RISK_MAX_DRAWDOWN=0.15         # 最大回撤阈值

# ── 日志 ─────────────────────────────────────────────────────
LOG_LEVEL=INFO                 # DEBUG | INFO | WARNING | ERROR
LOG_FILE=./logs/app.log

# ── Docker ───────────────────────────────────────────────────
POSTGRES_USER=guiyi
POSTGRES_PASSWORD=guiyi_dev_password
POSTGRES_DB=guiyi_quant
