{
  "name": "quant-web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc -b && vite build && node scripts/checkProductionBundleTopology.mjs dist",
    "test": "node --test tests/*.test.ts",
    "test:indicators": "node --test tests/indicators.test.ts",
    "test:e2e": "node e2e/run-mock-smoke.mjs",
    "test:e2e:readonly": "REAL_BACKEND=1 node e2e/run-readonly-smoke.mjs",
    "test:e2e:playwright-cli": "playwright test -c playwright.config.mjs",
    "preview": "vite preview"
  },
  "dependencies": {
    "@vueuse/core": "^14.3.0",
    "axios": "^1.18.0",
    "lightningcss": "^1.33.0",
    "lightweight-charts": "^5.2.0",
    "naive-ui": "^2.44.1",
    "pinia": "^3.0.4",
    "vue": "^3.5.34",
    "vue-router": "^5.1.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.52.0",
    "@types/node": "^24.12.3",
    "@vitejs/plugin-vue": "^6.0.6",
    "@vue/tsconfig": "^0.9.1",
    "typescript": "~6.0.2",
    "unplugin-auto-import": "^21.0.0",
    "unplugin-vue-components": "^32.1.0",
    "vite": "^8.0.12",
    "vue-tsc": "^3.2.8"
  }
}
