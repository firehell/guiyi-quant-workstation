# Narrow destructive Git protection. Rules match exact argument prefixes, not every
# semantically equivalent spelling or wrapper. Ordinary non-force pushes do not match.

prefix_rule(
    pattern = ["git", "push", ["--force", "--force-with-lease", "-f"]],
    decision = "forbidden",
    justification = "阻止 force push，不进入聊天确认后放行；请使用普通 push 和新的修正提交",
    match = [
        "git push --force origin develop",
        "git push --force-with-lease origin develop",
        "git push -f origin develop",
    ],
    not_match = [
        "git push origin develop",
        "git push origin develop --force",
        "git -c push.default=current push --force origin develop",
    ],
)
