{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://guiyi-quant.dev/schemas/epic-v2.0.json",
  "title": "GUIYI Epic Schema V2.0",
  "description": "Machine-readable Epic contract grouping multiple tasks with readiness flags.",
  "type": "object",
  "required": ["kind", "schema_version", "epic_id", "status", "risk_level"],
  "properties": {
    "kind": {
      "description": "Entity kind — must be 'Epic' for this schema",
      "const": "Epic"
    },
    "schema_version": {
      "description": "Fixed schema version identifier",
      "const": "2.0"
    },
    "epic_id": {
      "description": "Globally unique epic identifier",
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]+$"
    },
    "title": {
      "description": "Human-readable epic title",
      "type": "string"
    },
    "status": {
      "$ref": "#/$defs/status"
    },
    "risk_level": {
      "$ref": "#/$defs/risk_level"
    },
    "owner": {
      "description": "Epic owner",
      "type": "string",
      "default": "WorkBuddy"
    },
    "tasks": {
      "description": "Ordered list of child task IDs",
      "type": "array",
      "items": {"type": "string"},
      "default": []
    },
    "readiness_flags": {
      "description": "Boolean flags tracking epic readiness. All must be true before merging to main.",
      "type": "object",
      "additionalProperties": {
        "type": "boolean"
      },
      "default": {}
    },
    "created_at": {
      "type": "string",
      "format": "date"
    },
    "updated_at": {
      "type": "string",
      "format": "date"
    }
  },
  "$defs": {
    "status": {
      "description": "17-state machine status values (shared with task-v2.0 schema)",
      "enum": [
        "DRAFT", "REQUIREMENT_READY", "PLAN_READY", "APPROVED",
        "EXECUTING", "TESTING", "REVIEWING", "DELIVERY_READY",
        "GATE_PASSED", "CLOSED", "BLOCKED", "BLOCKED_BY_DEPENDENCY",
        "FAILED", "REPLAN", "CANCELLED", "SKIPPED_NOT_APPLICABLE",
        "SKIPPED_WITH_REASON"
      ]
    },
    "risk_level": {
      "description": "R0=致命 R1=高 R2=中 R3=低 (shared with task-v2.0 schema)",
      "enum": ["R0", "R1", "R2", "R3"]
    }
  }
}
