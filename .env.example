# 无需 Token，直接使用

# ── 前端配置 ─────────────────────────────────────────────────
VITE_API_BASE_URL=http://localhost:8000/api/v1
VITE_WS_URL=ws://localhost:8000/ws

# ── 回测引擎 ─────────────────────────────────────────────────
BACKTEST_DATA_PATH=./data/parquet
BACKTEST_RESULT_PATH=./backtests/results
BACKTEST_MAX_WORKERS=4

# ── 风控参数 ─────────────────────────────────────────────────
RISK_MAX_POSITION_RATIO=0.2    # 单品种最大仓位比例
RISK_MAX_DAILY_LOSS=0.05       # 单日最大亏损比例
RISK_MAX_DRAWDOWN=0.15         # 最大回撤阈值

# ── 日志 ─────────────────────────────────────────────────────
LOG_LEVEL=INFO                 # DEBUG | INFO | WARNING | ERROR
LOG_FILE=./logs/app.log

# ── Docker ───────────────────────────────────────────────────
POSTGRES_USER=guiyi
POSTGRES_PASSWORD=guiyi_dev_password
POSTGRES_DB=guiyi_quant
