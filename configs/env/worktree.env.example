# Worktree env source example.
# Copy outside the repository, fill real values there, then point GUIYI_ENV_SOURCE to that file.
# Do not commit the copied file or real credentials.

APP_ENV=development
DATABASE_URL=postgresql+psycopg://guiyi:replace-with-local-password@127.0.0.1:5432/guiyi_quant
POSTGRES_PASSWORD=replace-with-local-password
REDIS_PASSWORD=replace-with-local-password
REDIS_URL=redis://:replace-with-local-password@127.0.0.1:6379/0

# Optional data roots used by TASK Required Mounts.
GUIYI_DATA_ROOT=/Volumes/扩展盘/guiyi-parallel/workstation-router/data
