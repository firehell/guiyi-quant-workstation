# Mac mini FRPC 配置模板
# 复制到本机（勿提交 token）：/usr/local/etc/frp/frpc.toml 或 /opt/homebrew/etc/frp/frpc.toml
#
# 安装: brew install frpc
# 启动: brew services start frpc
# 预期日志: [guiyi-web] start proxy success / [guiyi-api] start proxy success

serverAddr = "frps.example.com"
serverPort = 7000

# 必须与 FRPS 使用同一 token；真实值只保存在本机的 0600 文件中。
auth.method = "token"
auth.tokenSource.type = "file"
auth.tokenSource.file.path = "/usr/local/etc/frp/client_token"

[[proxies]]
name = "guiyi-web"
type = "tcp"
localIP = "127.0.0.1"
localPort = 5173
remotePort = 18080

[[proxies]]
name = "guiyi-api"
type = "tcp"
localIP = "127.0.0.1"
localPort = 8000
remotePort = 18000
