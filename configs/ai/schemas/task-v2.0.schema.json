{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://guiyi-quant.dev/schemas/task-v2.0.json",
  "title": "GUIYI Task Schema V2.0",
  "description": "Machine-readable Task contract for the GUIYI Quant workstation. YAML frontmatter + Markdown body.",
  "type": "object",
  "required": ["kind", "schema_version", "task_id", "status", "risk_level", "work_level", "approval_scope"],
  "properties": {
    "kind": {
      "description": "Entity kind — must be 'Task' for this schema",
      "enum": ["Task"]
    },
    "schema_version": {
      "description": "Fixed schema version identifier",
      "const": "2.0"
    },
    "task_id": {
      "description": "Globally unique task identifier (alphanumeric + hyphens/underscores)",
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]+$"
    },
    "epic_id": {
      "description": "Parent epic identifier, if this task belongs to an epic",
      "type": "string"
    },
    "title": {
      "description": "Human-readable task title",
      "type": "string"
    },
    "status": {
      "$ref": "#/$defs/status"
    },
    "risk_level": {
      "$ref": "#/$defs/risk_level"
    },
    "work_level": {
      "$ref": "#/$defs/work_level"
    },
    "approval_scope": {
      "description": "Explicit approval scope, independent of status",
      "type": "array",
      "items": {
        "enum": ["plan", "code", "production_write", "external_review"]
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "depends_on": {
      "description": "Task IDs that must be CLOSED or SKIPPED before this task can start",
      "type": "array",
      "items": {"type": "string"},
      "default": []
    },
    "allowed_paths": {
      "description": "File/directory globs that this task is permitted to modify",
      "type": "array",
      "items": {"type": "string"},
      "default": []
    },
    "forbidden_paths": {
      "description": "File/directory globs that this task MUST NOT touch",
      "type": "array",
      "items": {"type": "string"},
      "default": []
    },
    "resource_locks": {
      "description": "Named resource locks required before execution",
      "type": "array",
      "items": {"type": "string"},
      "default": []
    },
    "required_tests": {
      "description": "Shell commands that must pass (exit 0) before this task can progress",
      "type": "array",
      "items": {"type": "string"},
      "default": []
    },
    "model_profile": {
      "description": "Abstract model capability profile — never hardcode a specific model name",
      "enum": ["fast", "standard", "deep", "critical"],
      "default": "standard"
    },
    "critical": {
      "description": "Marks strategy/backtest/database tasks requiring extra caution",
      "type": "boolean",
      "default": false
    },
    "production_write_approved": {
      "description": "Whether production write operations have been explicitly approved",
      "type": "boolean",
      "default": false
    },
    "github_issue": {
      "description": "Linked GitHub Issue in #N format",
      "type": "string",
      "pattern": "^#[0-9]+$"
    },
    "branch": {
      "description": "Git branch for this task's worktree",
      "type": "string"
    },
    "worktree": {
      "description": "Absolute path to this task's git worktree",
      "type": "string"
    },
    "owner": {
      "description": "Task owner / responsible agent",
      "type": "string",
      "default": "WorkBuddy"
    },
    "created_at": {
      "description": "ISO 8601 date of task creation",
      "type": "string",
      "format": "date"
    },
    "updated_at": {
      "description": "ISO 8601 date of last metadata update",
      "type": "string",
      "format": "date"
    }
  },
  "$defs": {
    "status": {
      "description": "17-state machine status values",
      "enum": [
        "DRAFT",
        "REQUIREMENT_READY",
        "PLAN_READY",
        "APPROVED",
        "EXECUTING",
        "TESTING",
        "REVIEWING",
        "DELIVERY_READY",
        "GATE_PASSED",
        "CLOSED",
        "BLOCKED",
        "BLOCKED_BY_DEPENDENCY",
        "FAILED",
        "REPLAN",
        "CANCELLED",
        "SKIPPED_NOT_APPLICABLE",
        "SKIPPED_WITH_REASON"
      ]
    },
    "risk_level": {
      "description": "R0=致命 R1=高 R2=中 R3=低",
      "enum": ["R0", "R1", "R2", "R3"]
    },
    "work_level": {
      "description": "L0=AI-only L1=AI+human-review L2=human-required",
      "enum": ["L0", "L1", "L2"]
    }
  }
}
