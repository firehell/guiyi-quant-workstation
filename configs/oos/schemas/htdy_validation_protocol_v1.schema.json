{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://guiyi-quant.dev/schemas/htdy_validation_protocol_v1",
  "title": "HTDY Strict Validation Protocol V1",
  "description": "Machine-readable HTDY validation protocol prepared before formal backtest/OOS. Not final frozen.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "task_id",
    "freeze_status",
    "cursor_gate",
    "persist_to_db",
    "baseline_report_id",
    "report14_policy",
    "frozen_strategy",
    "profile_id",
    "frozen_data_policy",
    "parameter_hash",
    "indicator_policy_snapshot",
    "frozen_costs",
    "frozen_execution_rules",
    "required_metrics",
    "hard_reject_criteria",
    "e5_05_branch",
    "research_status_lifecycle",
    "windows"
  ],
  "properties": {
    "schema_version": {
      "const": "htdy_validation_protocol_v1"
    },
    "task_id": {
      "type": "string",
      "minLength": 1
    },
    "handbook_task": {
      "type": "string"
    },
    "legacy_task_alias": {
      "type": "string"
    },
    "freeze_status": {
      "const": "protocol_prepared_not_final_frozen"
    },
    "cursor_gate": {
      "const": "CURSOR_VALIDATION_PROTOCOL_PREPARED"
    },
    "persist_to_db": {
      "const": false
    },
    "baseline_report_id": {
      "type": "null"
    },
    "report14_policy": {
      "const": "do_not_touch"
    },
    "d4_00_gate": {
      "type": "string"
    },
    "notes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "frozen_strategy": {
      "type": "object",
      "required": [
        "strategy_code",
        "strategy_version",
        "indicator_version",
        "entry_interval",
        "product",
        "contract",
        "contract_role",
        "actual_contract_in_scope",
        "period",
        "fill_policy"
      ],
      "properties": {
        "strategy_code": {
          "const": "huotian_dayou_strict"
        },
        "strategy_version": {
          "const": "v0.1.0-backtest-candidate"
        },
        "strategy_class_path": {
          "type": "string"
        },
        "indicator_version": {
          "const": "huotian_dayou_strict_v1"
        },
        "candidate_policy": {
          "type": "string"
        },
        "execution_scope": {
          "type": "string"
        },
        "entry_interval": {
          "const": "15m"
        },
        "product": {
          "const": "JM"
        },
        "symbol": {
          "type": "string"
        },
        "contract": {
          "const": "jm.MAIN"
        },
        "contract_role": {
          "const": "dominant_main_continuous"
        },
        "actual_contract_in_scope": {
          "const": false
        },
        "period": {
          "const": "15m"
        },
        "fill_policy": {
          "const": "signal_on_close_fill_next_bar_open"
        }
      },
      "additionalProperties": true
    },
    "profile_id": {
      "const": "intraday_research_v1"
    },
    "frozen_data_policy": {
      "type": "object",
      "required": [
        "data_role",
        "quality_status",
        "execution_timing",
        "confirmed_only"
      ],
      "properties": {
        "provider": {
          "type": "string"
        },
        "data_source": {
          "type": "string"
        },
        "data_role": {
          "const": "primary"
        },
        "quality_status": {
          "const": "passed"
        },
        "execution_timing": {
          "const": "next_bar_open"
        },
        "confirmed_only": {
          "const": true
        },
        "data_version": {
          "type": "string"
        },
        "relative_path": {
          "type": "string"
        },
        "source_file_sha256": {
          "type": "string",
          "minLength": 64,
          "maxLength": 64
        },
        "full_window_start": {
          "type": "string"
        },
        "full_window_end": {
          "type": "string"
        }
      },
      "additionalProperties": true
    },
    "parameter_hash": {
      "type": "string",
      "minLength": 64,
      "maxLength": 64
    },
    "parameter_hash_method": {
      "type": "string"
    },
    "parameter_source": {
      "type": "string"
    },
    "indicator_policy_snapshot": {
      "type": "object",
      "required": [
        "schema_version",
        "strategy_code",
        "strategy_version",
        "indicator_versions",
        "formal_policy_ids",
        "profile_id",
        "confirmed_only",
        "execution_timing",
        "cost_model_version",
        "research_status"
      ],
      "properties": {
        "schema_version": {
          "const": "strategy_indicator_policy_v1"
        },
        "strategy_code": {
          "const": "huotian_dayou_strict"
        },
        "strategy_version": {
          "const": "v0.1.0-backtest-candidate"
        },
        "indicator_versions": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "formal_policy_ids": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "profile_id": {
          "type": "string"
        },
        "confirmed_only": {
          "const": true
        },
        "execution_timing": {
          "type": "string"
        },
        "cost_model_version": {
          "type": "string"
        },
        "research_status": {
          "type": "string"
        },
        "frozen_legacy": {
          "type": "boolean"
        },
        "cost_parameters": {
          "type": "object"
        }
      },
      "additionalProperties": true
    },
    "frozen_costs": {
      "type": "object",
      "required": [
        "capital",
        "maximum_position",
        "risk_per_trade_ratio",
        "slippage_ticks",
        "missing_cost_fields_policy"
      ],
      "additionalProperties": true
    },
    "frozen_execution_rules": {
      "type": "object",
      "required": [
        "fill_policy",
        "stop_buffer_ticks",
        "take_profit_r_multiple",
        "planned_time_exit_bars",
        "reverse_policy",
        "conflict_policy",
        "same_bar_exit_priority"
      ],
      "additionalProperties": true
    },
    "required_metrics": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "hard_reject_criteria": {
      "type": "object",
      "required": [
        "structural_any_of",
        "oos_fixed_any_of",
        "on_trigger_gate",
        "forbid_param_retune_to_mask_failure"
      ],
      "properties": {
        "structural_any_of": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "oos_fixed_any_of": {
          "type": "object",
          "required": [
            "window_id",
            "max_drawdown_pct_gt",
            "max_consecutive_losses_gte",
            "trade_count_lt",
            "profit_factor_lt",
            "total_return_pct_lte"
          ],
          "properties": {
            "window_id": {
              "const": "oos_fixed"
            },
            "max_drawdown_pct_gt": {
              "type": "number"
            },
            "max_consecutive_losses_gte": {
              "type": "integer"
            },
            "trade_count_lt": {
              "type": "integer"
            },
            "profit_factor_lt": {
              "type": "number"
            },
            "total_return_pct_lte": {
              "type": "number"
            }
          },
          "additionalProperties": true
        },
        "on_trigger_gate": {
          "const": "OOS_HARD_REJECT_TRIGGERED"
        },
        "forbid_param_retune_to_mask_failure": {
          "const": true
        }
      },
      "additionalProperties": true
    },
    "e5_05_branch": {
      "type": "object",
      "required": [
        "handbook_task",
        "codex_task",
        "on_oos_hard_reject"
      ],
      "properties": {
        "handbook_task": {
          "const": "E5-05"
        },
        "codex_task": {
          "const": "X5-05"
        },
        "on_oos_hard_reject": {
          "type": "object",
          "required": [
            "skip_x5_05_rolling_by_default",
            "allowed_followups",
            "forbidden",
            "allowed_labels"
          ],
          "properties": {
            "skip_x5_05_rolling_by_default": {
              "const": true
            },
            "allowed_followups": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string"
              }
            },
            "forbidden": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string"
              }
            },
            "allowed_labels": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string"
              }
            },
            "note": {
              "type": "string"
            }
          },
          "additionalProperties": true
        }
      },
      "additionalProperties": true
    },
    "research_status_lifecycle": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "string"
      }
    },
    "live_signal_wecom_in_scope": {
      "const": false
    },
    "windows": {
      "type": "array",
      "minItems": 5,
      "items": {
        "type": "object",
        "required": [
          "id",
          "start",
          "end",
          "purpose"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "label": {
            "type": "string"
          },
          "start": {
            "type": "string"
          },
          "end": {
            "type": "string"
          },
          "purpose": {
            "type": "string"
          },
          "train_window": {
            "type": "string"
          }
        },
        "additionalProperties": true
      }
    }
  }
}
