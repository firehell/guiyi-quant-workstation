  "method": {
    "latency": "monotonic wall time from completed Redis H1 batch publish returning to each native SQLite H1 commit returning; includes fixture readback and serialized ledger writes",
    "percentiles": "pooled per-product values from three H1 batches in each mode, linear interpolation",
    "coverage": "the running revision, publish, readback and compute loop starts before completed H1 publication returns; the 16th SQLite commit signals stop and the worker finishes the open receipt",
    "accept_overlap": "union of first accept execution intervals overlapping the measured H1 window; excludes revision publication and duplicate accepts",
    "worker_overlap": "monotonic intersections of the actual Live and Canonical worker callbacks",
    "handoff": "outer loop handoff from one revision cycle ending to the next starting; includes the nonblocking stop check and excludes within-cycle I/O",
    "source_backlog": "Redis source entries after the actual Live cursor; sampled before each publisher poll and at test end",
    "receipt_backlog": "retained revised receipts minus accepted receipts after draining, verified from the isolated receipt directory"
  },
