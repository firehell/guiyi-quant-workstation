# Personal development mode: retain only narrow destructive Git protections.
# Ordinary develop push/edit is allowed. Collaboration entrypoints are not required.

prefix_rule(
    pattern = ["git", "push", "--force"],
    decision = "forbidden",
    justification = "禁止 force push；历史重写属于受控外部操作，需单独明确意图",
)

prefix_rule(
    pattern = ["git", "push", "--force-with-lease"],
    decision = "forbidden",
    justification = "禁止 force-with-lease push；属于受控外部操作",
)

prefix_rule(
    pattern = ["git", "push", "-f"],
    decision = "forbidden",
    justification = "禁止 -f force push；属于受控外部操作",
)
