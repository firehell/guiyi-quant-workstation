# ============================================================
# 归一量化工作站 — 环境变量模板
# 复制为 .env 并填入真实值，.env 文件严禁提交到 Git
# ============================================================

# ── 应用基础配置 ────────────────────────────────────────────
APP_ENV=development          # development | staging | production
APP_PORT=8000
APP_SECRET_KEY=replace-with-a-long-random-secret

# ── 数据库 ──────────────────────────────────────────────────
# 必须使用 postgresql+psycopg（psycopg v3）；裸 postgresql:// 会误选 psycopg2
DATABASE_URL=postgresql+psycopg://guiyi:replace-with-a-long-random-password@127.0.0.1:5432/guiyi_quant
REDIS_URL=redis://:replace-with-a-long-random-password@127.0.0.1:6379/0

# ── 数据源：米筐 RQData ──────────────────────────────────────
# V1 主链路：RQData → standard parquet → DuckDB/PostgreSQL → vn.py 回测。
# 本地 Parquet 是标准化后的正式数据湖，不是外部备用数据源。
GUIYI_DATA_SOURCE_PRIMARY=rqdata
GUIYI_DATA_SOURCE_FALLBACKS=local_parquet

# 米筐 / RQData license key（真实值只写入本地 .env，严禁提交）
RQDATA_LICENSE_KEY=your_rqdata_license_key

# ── 前端配置 ─────────────────────────────────────────────────
# 默认使用同源相对路径，本地 dev 由 Vite proxy 转发 /api 到后端
VITE_API_BASE_URL=/api/v1
# 留空则自动推断 ws(s)://{host}/ws
VITE_WS_URL=

# 公网直连 API 时的额外 CORS origin（逗号分隔，经 Nginx 同源访问通常不需要）
# 例: CORS_ORIGINS=http://124.221.95.93,https://workstation.example.com
CORS_ORIGINS=

# ── 回测引擎 ─────────────────────────────────────────────────
BACKTEST_DATA_PATH=./data/parquet
BACKTEST_RESULT_PATH=./backtests/results
BACKTEST_MAX_WORKERS=4

# ── 风控参数 ─────────────────────────────────────────────────
RISK_MAX_POSITION_RATIO=0.2    # 单品种最大仓位比例
RISK_MAX_DAILY_LOSS=0.05       # 单日最大亏损比例
RISK_MAX_DRAWDOWN=0.15         # 最大回撤阈值

# ── 日志 ─────────────────────────────────────────────────────
LOG_LEVEL=INFO                 # DEBUG | INFO | WARNING | ERROR
LOG_FILE=./logs/app.log

# ── Docker ───────────────────────────────────────────────────
POSTGRES_USER=guiyi
POSTGRES_PASSWORD=replace-with-a-long-random-password
POSTGRES_DB=guiyi_quant
POSTGRES_PORT=5432
REDIS_PASSWORD=replace-with-a-long-random-password
REDIS_PORT=6379
