# 归一量化最小环境模板。真实值只存本机安全配置，不得提交。
# launchd 优先读取 ~/Library/Application Support/GuiyiQuant/project.env；仓库 .env 仅作本地 fallback。

# PostgreSQL / Redis
DATABASE_URL=postgresql+psycopg://guiyi:replace-with-password@127.0.0.1:5432/guiyi_quant
POSTGRES_PASSWORD=replace-with-password
REDIS_URL=redis://:replace-with-password@127.0.0.1:6379/0
REDIS_PASSWORD=replace-with-password

# Canonical Parquet 唯一历史数据根，必须是绝对路径
GUIYI_CANONICAL_DATA_ROOT=/absolute/path/to/guiyi-canonical

# RQData：按本机账号类型填写；未使用的认证字段保持为空
RQDATA_LICENSE_KEY=
RQDATA_USERNAME=
RQDATA_PASSWORD=
RQDATA_ADDR=

# HTTP
CORS_ORIGINS=

# Web：默认同源；本地开发由 Vite proxy 转发
VITE_API_BASE_URL=/api/v1
VITE_MARKET_WS_URL=
VITE_PROXY_API_TARGET=http://127.0.0.1:8000
VITE_PROXY_WS_TARGET=ws://127.0.0.1:8000

# 苏冰今日观察：必须指向已挂载扩展盘，不提供系统盘 fallback
GUIYI_SUBING_OBSERVATION_ROOT=/Volumes/<mounted-volume>/guiyi-quant-data/observations/subing-daily-v1

# docker-compose 本地依赖
POSTGRES_USER=guiyi
POSTGRES_DB=guiyi_quant
POSTGRES_PORT=5432
REDIS_PORT=6379
