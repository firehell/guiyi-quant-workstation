# ============================================================
# 归一量化工作站 — 环境变量模板
# 复制为 .env 并填入真实值，.env 文件严禁提交到 Git
# ============================================================

# ── 应用基础配置 ────────────────────────────────────────────
APP_ENV=development          # development | staging | production
APP_PORT=8000
APP_SECRET_KEY=change-me-to-a-random-secret

# ── 数据库 ──────────────────────────────────────────────────
# 必须使用 postgresql+psycopg（psycopg v3）；裸 postgresql:// 会误选 psycopg2
DATABASE_URL=postgresql+psycopg://guiyi:guiyi_dev_password@127.0.0.1:5432/guiyi_quant
REDIS_URL=redis://127.0.0.1:6379/0

# ── 期货行情数据源 ────────────────────────────────────────────
# V0 先用 sample/mock 跑通本地闭环；V1 以 TqSdk 为核心目标数据源，
# RQData / Tushare / AKShare 仅作为补充适配或交叉校验。
GUIYI_DATA_SOURCE_PRIMARY=tqsdk
GUIYI_DATA_SOURCE_FALLBACKS=rqdata,tushare,akshare

# 米筐 / RQData（真实 license 只写入本地 .env 或 .env.local，严禁提交）
